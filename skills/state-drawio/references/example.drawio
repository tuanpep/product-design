        <mxCell id="tr-4" value="[roster update fails] / alert charge nurse" style="endArrow=open;html=1;rounded=0;align=center;verticalAlign=bottom;endFill=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;endSize=8;strokeColor=#1f2937;fontSize=11;fontColor=#1b1f24;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-choice-1" target="st-needs-roster-fix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr-5" value="charge nurse fixes roster / notify both" style="endArrow=open;html=1;rounded=0;align=center;verticalAlign=bottom;endFill=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;endSize=8;strokeColor=#1f2937;fontSize=11;fontColor=#1b1f24;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-needs-roster-fix" target="st-accepted"><mxGeometry relative="1" as="geometry" /></mxCell>
