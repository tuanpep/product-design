        <mxCell id="tr-8" value="when shift starts in 12 h / notify requester (M4)" style="endArrow=open;html=1;rounded=0;align=center;verticalAlign=bottom;endFill=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;endSize=8;strokeColor=#1f2937;fontSize=11;fontColor=#1b1f24;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-waiting" target="st-expired"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr-9" value="shift starts" style="endArrow=open;html=1;rounded=0;align=center;verticalAlign=bottom;endFill=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;endSize=8;strokeColor=#1f2937;fontSize=11;fontColor=#1b1f24;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-accepted" target="st-final"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr-10" value="charge nurse reverses [BR4] / restore roster (I1)" style="endArrow=open;html=1;rounded=0;align=center;verticalAlign=bottom;endFill=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;endSize=8;strokeColor=#1f2937;fontSize=11;fontColor=#1b1f24;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-accepted" target="st-reversed"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cover-request-note" value="Question: what happens to a cover request when nobody answers, or the roster cannot be updated? It expires 12 hours before the shift (proposed default, Q3), and a failed roster update waits for the charge nurse instead of silently showing Accepted.&lt;br&gt;Source: build-spec.md States and lifecycle, Business rules BR1, BR2, BR4, and integration I1. Grey states are terminal. Reversed is the way back from Accepted, before the shift starts. Declined, Cancelled, and Expired have no way back: the requester sends a new request.&lt;br&gt;Proposed. It does not test that the product enforces these transitions or that people understand them." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1520" height="88" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
